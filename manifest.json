{
  "manifest_version": 2,
  "name": "Tidier",
  "version": "1.6",
  "description": "Firefox in the shape of Zen and Arc: essentials and tabs in every window, live folders of GitHub pull requests, archiving of unused tabs, and ⌘⇧C to copy the address.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{6844a953-9931-4334-9ff6-257c246485cb}",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/CHaerem/tidier/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "sessions",
    "storage",
    "cookies",
    "nativeMessaging",
    "alarms",
    "clipboardWrite",
    "contextualIdentities",
    "menus",
    "menus.overrideContext"
  ],
  "optional_permissions": [
    "tabHide",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "proxy",
    "browsingData",
    "search",
    "history",
    "bookmarks"
  ],
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Tidier",
    "default_icon": "icon.svg"
  },
  "browser_action": {
    "default_title": "Tidier",
    "default_icon": "icon.svg",
    "default_area": "menupanel"
  },
  "background": {
    "scripts": [
      "common.js",
      "bridge.js",
      "essentials.js",
      "tabsync.js",
      "livefolders.js",
      "rulematch.js",
      "spaces.js",
      "spaceactions.js",
      "newtabs.js",
      "ownfolders.js",
      "safemoves.js",
      "tabactions.js",
      "foldrest.js",
      "littlewindow.js",
      "copies.js",
      "tabnames.js",
      "moveover.js",
      "quiet.js",
      "isolation.js",
      "hiddenspaces.js",
      "syncmerge.js",
      "sync.js",
      "sidebar-view.js",
      "sounds.js",
      "news.js",
      "archivelist.js",
      "archive.js",
      "keys-commands.js",
      "shortcuts.js",
      "commandbar.js"
    ],
    "persistent": true
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy the address of the current tab"
    },
    "_execute_sidebar_action": { "description": "Show or hide Tidier's sidebar" },
    "space-1": { "description": "Go to the first space" },
    "space-2": { "description": "Go to the second space" },
    "space-3": { "description": "Go to the third space" },
    "space-4": { "description": "Go to the fourth space" },
    "space-5": { "description": "Go to the fifth space" },
    "command-bar": { "description": "Open or close the command bar" },
    "command-bar-t": { "description": "The command bar's second key, once Firefox lets go of it" },
    "next-tab": { "description": "Next tab" },
    "previous-tab": { "description": "Previous tab" },
    "next-space": { "description": "Next space" },
    "previous-space": { "description": "Previous space" },
    "toggle-essential": { "description": "Make this tab an essential, or not" },
    "new-folder": { "description": "New folder" },
    "tab-1": { "description": "Go to the first tab of this space" },
    "tab-2": { "description": "Go to the second tab of this space" },
    "tab-3": { "description": "Go to the third tab of this space" },
    "tab-4": { "description": "Go to the fourth tab of this space" },
    "tab-5": { "description": "Go to the fifth tab of this space" },
    "tab-6": { "description": "Go to the sixth tab of this space" },
    "tab-7": { "description": "Go to the seventh tab of this space" },
    "tab-8": { "description": "Go to the eighth tab of this space" },
    "tab-9": { "description": "Go to the ninth tab of this space" },
    "claude-copy-page": { "description": "Copy this page for Claude (once turned on in Tidier's settings)" },
    "claude-copy-tabs": { "description": "Copy this space's tabs for Claude (once turned on in Tidier's settings)" },
    "claude-ask": { "description": "Ask Claude about this page (once turned on in Tidier's settings)" }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}

{
  "manifest_version": 2,
  "name": "Tidier",
  "version": "1.6",
  "description": "Firefox in the shape of Zen and Arc: spaces with their own logins, essentials and folders, the same tabs in every window, and tabs that tidy themselves.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{6844a953-9931-4334-9ff6-257c246485cb}",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/CHaerem/tidier/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "sessions",
    "storage",
    "cookies",
    "nativeMessaging",
    "alarms",
    "clipboardWrite",
    "activeTab",
    "contextualIdentities",
    "menus",
    "menus.overrideContext"
  ],
  "optional_permissions": [
    "tabHide",
    "webRequest",
    "webRequestBlocking",
    "*://*/*",
    "<all_urls>",
    "proxy",
    "browsingData",
    "search",
    "history",
    "bookmarks"
  ],
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Tidier",
    "default_icon": "icon.svg"
  },
  "browser_action": {
    "default_title": "Tidier",
    "default_icon": "icon.svg",
    "default_area": "menupanel"
  },
  "background": {
    "scripts": [
      "common.js",
      "listactions.js",
      "droplinks.js",
      "bridge.js",
      "essentials.js",
      "tabsync.js",
      "livefolders.js",
      "firefoxsetup.js",
      "rulematch.js",
      "spaces.js",
      "spaceactions.js",
      "newtabs.js",
      "ownfolders.js",
      "safemoves.js",
      "tabactions.js",
      "foldrest.js",
      "littlewindow.js",
      "copies.js",
      "tabnames.js",
      "moveover.js",
      "aftermove.js",
      "quiet.js",
      "isolation.js",
      "hiddenspaces.js",
      "syncmerge.js",
      "sync.js",
      "sidebar-view.js",
      "sounds.js",
      "news.js",
      "archivelist.js",
      "archive.js",
      "keys-commands.js",
      "pagenote.js",
      "shortcuts.js",
      "commandbar.js"
    ],
    "persistent": true
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy the address of the current tab"
    },
    "_execute_sidebar_action": { "description": "Show or hide Tidier's sidebar" },
    "space-1": { "description": "Go to the first space" },
    "space-2": { "description": "Go to the second space" },
    "space-3": { "description": "Go to the third space" },
    "space-4": { "description": "Go to the fourth space" },
    "space-5": { "description": "Go to the fifth space" },
    "command-bar": { "description": "Open or close the command bar" },
    "command-bar-t": { "description": "A second key for the command bar, such as ⌘T once Firefox lets go of it" },
    "next-tab": { "description": "Next tab" },
    "previous-tab": { "description": "Previous tab" },
    "next-space": { "description": "Next space" },
    "previous-space": { "description": "Previous space" },
    "toggle-essential": { "description": "Make this tab an essential, or not" },
    "new-folder": { "description": "New folder" },
    "tab-1": { "description": "Go to the first tab of this space" },
    "tab-2": { "description": "Go to the second tab of this space" },
    "tab-3": { "description": "Go to the third tab of this space" },
    "tab-4": { "description": "Go to the fourth tab of this space" },
    "tab-5": { "description": "Go to the fifth tab of this space" },
    "tab-6": { "description": "Go to the sixth tab of this space" },
    "tab-7": { "description": "Go to the seventh tab of this space" },
    "tab-8": { "description": "Go to the eighth tab of this space" },
    "tab-9": { "description": "Go to the ninth tab of this space" },
    "sort-name": { "description": "Sort today's tabs or this folder by name" },
    "sort-site": { "description": "Sort today's tabs or this folder by site" },
    "sort-used": { "description": "Sort today's tabs or this folder by last use" },
    "move-top": { "description": "Move to the top" },
    "move-bottom": { "description": "Move to the bottom" },
    "move-up": { "description": "Move up one place" },
    "move-down": { "description": "Move down one place" },
    "take-out": { "description": "Take out of its folder" },
    "folder-from-selection": { "description": "New folder with these tabs" },
    "copy-markdown": { "description": "Copy as Markdown links" },
    "close-duplicates": { "description": "Close duplicate tabs" },
    "close-others": { "description": "Close other tabs" },
    "close-above": { "description": "Close tabs above" },
    "close-below": { "description": "Close tabs below" },
    "recent-back": { "description": "Back to the tab used before" },
    "recent-forward": { "description": "Forward to the tab used after" },
    "folder-new-tab": { "description": "New tab in this folder" },
    "folder-copy": { "description": "Copy this folder's addresses" },
    "folder-copy-markdown": { "description": "Copy this folder as Markdown links" },
    "folder-reload": { "description": "Reload this folder" },
    "folder-mute": { "description": "Mute this folder" },
    "folder-unmute": { "description": "Unmute this folder" },
    "folder-unload": { "description": "Unload this folder" },
    "folder-close": { "description": "Close this folder's tabs" },
    "space-reload": { "description": "Reload this space" },
    "space-mute": { "description": "Mute this space" },
    "space-unmute": { "description": "Unmute this space" },
    "space-unload": { "description": "Unload this space" },
    "space-unload-others": { "description": "Unload the other spaces" },
    "folders-fold": { "description": "Close all folders, or open them" },
    "claude-copy-page": { "description": "Copy this page for Claude (once turned on in its settings)" },
    "claude-copy-tabs": { "description": "Copy this space's tabs for Claude (once turned on in its settings)" },
    "claude-ask": { "description": "Ask Claude about this page (once turned on in its settings)" }
  },
  "icons": {
    "48": "icon-addon.svg",
    "96": "icon-addon.svg"
  }
}
